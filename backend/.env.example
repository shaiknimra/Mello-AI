# Mello AI Backend Configuration

# Server Settings
APP_ENV=development
DEBUG=True
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# LLM Configuration
# Options: "gemini" or "mock" (use "mock" for testing without an API key)
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Support & Contact (Configurable, never invent real customer emails)
SUPPORT_EMAIL=support@example.com
